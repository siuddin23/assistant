# Salin ke .env (lokal) atau isi sebagai GitHub Actions Secrets. Jangan commit file .env.

# Meta: System User token dari Business Settings > Users > System users (izin ads_read)
META_ACCESS_TOKEN=

# Google: isi JSON service account (satu baris). Share spreadsheet ke email service account (Viewer).
GOOGLE_SERVICE_ACCOUNT_JSON=

# Telegram: token dari @BotFather, chat_id grup/pribadi tujuan
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp via Fonnte (fonnte.com): token device + nomor/ID grup tujuan (pisahkan koma)
FONNTE_TOKEN=
WHATSAPP_TARGET=

# Opsional: insight AI dari Claude (console.anthropic.com)
ANTHROPIC_API_KEY=
