{
  "name": "glowlab-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.mts",
    "create-user": "tsx scripts/create-user.mts",
    "sync-sheet": "tsx --conditions=react-server scripts/sync-sheet.mts",
    "vercel-build": "tsx scripts/migrate.mts && next build"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "google-auth-library": "^11.3.1",
    "jose": "^6.2.13",
    "next": "^15.5.28",
    "papaparse": "^5.7.0",
    "postgres": "^3.4.9",
    "react": "19.2",
    "react-dom": "19.2",
    "read-excel-file": "^9.3.12",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^3.2.7"
  }
