# Postgres (Supabase / Neon / Vercel Postgres). Untuk Supabase pakai connection string "Transaction pooler".
DATABASE_URL=postgres://postgres:postgres@localhost:5432/glowlab

# Rahasia acak minimal 32 karakter untuk cookie login: openssl rand -base64 48
SESSION_SECRET=

# Google service account (JSON satu baris) yang punya akses Viewer ke spreadsheet
GOOGLE_SERVICE_ACCOUNT_JSON=
SPREADSHEET_ID=16Mla00sapW6GKX60kb5Wmaq6zaFDLHxISWxGT5pfy-0

# Token rahasia untuk URL webhook Globemerce: /api/webhooks/globemerce?token=...
GLOBEMERCE_WEBHOOK_TOKEN=

# Token untuk job Python mengirim spend Meta Ads ke /api/ingest/ad-spend
INGEST_TOKEN=

# Rahasia untuk endpoint sinkron terjadwal /api/cron/sync-sheet
CRON_SECRET=
